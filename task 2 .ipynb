# circle & triangle
sides = int(input("Enter the number of sides: "))
if sides == 0:
    print("Shape is a Circle")
    radius = float(input("Enter the radius: "))
    area = 3.14 * radius * radius
    print(f"Area: {area}")

elif sides == 3:
    print("Shape is a Triangle")
    base = float(input("Enter the base: "))
    height = float(input("Enter the height: "))
    area = (base * height) / 2
    print(f"Area: {area}")
else:
    print("Unknown shape")


#bmi
height = float(input("Enter height in cm: "))
weight = float(input("Enter weight in kg: "))
bmi = weight / (height / 100) ** 2
print("Your BMI is:", bmi)
if bmi >= 25:
    print("Status: Overweight")
    print("Units to lose:", bmi - 25)
elif bmi >= 18.5:
    print("Status: Fit and healthy!")
else:
    print("Status: Underweight")
    print("Units to gain:", 18.5 - bmi)


# sum of odd and even integer
count = int(input("Enter number of integers: "))
even_sum = 0
odd_sum = 0

for i in range(count):
    num = int(input("Enter integer: "))
    if num % 2 == 0:
        even_sum += num
    else:
        odd_sum += num
print("Sum of even numbers is:", even_sum)
print("Sum of odd numbers is:", odd_sum)


#multiplication tabel
num = int(input("Enter a positive number: "))
for i in range(1, 13):
    print(num, "*", i, "=", num * i)


#factorial
num = int(input("Enter a number: "))
fact = 1
for i in range(1, num + 1):
    fact *= i
print("Factorial of the number is:", fact)


#ascii values
char = input("Enter a character: ")
print("ASCII value =", ord(char))

#harshad number
num = int(input("Enter a number: "))
temp = num
digit_sum = 0
while temp > 0:
    digit = temp % 10
    digit_sum = digit_sum + digit
    temp = temp // 10
if num % digit_sum == 0:
    print("Harshad number")
else:
    print("Not a harshad number")

#sum of divisior
num = int(input("Enter a number: "))
div_sum = 0
i = 1
while i <= num:
    if num % i == 0:
        div_sum += i
    i += 1
print("Sum of divisors is:", div_sum)

#palindrom
num = int(input("Enter a number: "))
temp = num
reversed_num = 0
while temp > 0:
    digit = temp % 10
    reversed_num = (reversed_num * 10) + digit
    temp = temp // 10
if num == reversed_num:
    print("Palindrome")
else:
    print("Not a palindrome")

#amstrong number
num = int(input("Enter a number: "))
temp = num
armstrong_sum = 0
while temp > 0:
    digit = temp % 10
    armstrong_sum = armstrong_sum + (digit ** 3)
    temp = temp // 10
if num == armstrong_sum:
    print("Armstrong Number")
else:
    print("Not an Armstrong Number")
