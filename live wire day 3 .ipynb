last_two = num % 100

print("The last 2 digits are:", last_two)


#3. Find the middle digit (of a 3-digit number)
num = 789
middle = (num // 10) % 10

print("The middle digit is:", middle)


#4. Square the middle digit of a 5-digit number
num = 54623

# Get the middle digit
middle = (num // 100) % 10
square = middle * middle

print("Square of", middle, "is:", square)


